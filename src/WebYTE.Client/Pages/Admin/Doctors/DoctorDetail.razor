@page "/admin/doctors/{DoctorId:guid}"
@using WebYTE.Application.DTOs.Doctor
@using WebYTE.Application.DTOs.Admin
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Chi Tiết Bác Sĩ</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Large" Class="mr-2" />
        Chi Tiết Bác Sĩ
    </MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (doctor != null)
    {
        <MudPaper Elevation="3" Class="pa-6">
            <EditForm Model="@updateDto" OnValidSubmit="HandleUpdate">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Họ Tên" @bind-Value="updateDto.FullName" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Số Điện Thoại" @bind-Value="updateDto.Phone" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid" Label="Chuyên Khoa" @bind-Value="updateDto.SpecialtyId" Required="true">
                            @foreach (var specialty in specialties)
                            {
                                <MudSelectItem Value="@specialty.Id">@specialty.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Bằng Cấp" @bind-Value="updateDto.Qualifications" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Kinh Nghiệm" @bind-Value="updateDto.Experience" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField Label="Phí Khám (VNĐ)" @bind-Value="updateDto.ConsultationFee" Min="0" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Label="Giới Thiệu" @bind-Value="updateDto.Bio" Lines="4" />
                    </MudItem>
                    <MudItem xs="12" Class="d-flex gap-2">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                            Cập Nhật
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="GoBack">
                            Quay Lại
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Error">Không tìm thấy thông tin bác sĩ.</MudAlert>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid DoctorId { get; set; }

    private DoctorProfileDto? doctor;
    private UpdateDoctorProfileDto updateDto = new();
    private List<SpecialtyDto> specialties = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSpecialties();
        await LoadDoctor();
    }

    private async Task LoadSpecialties()
    {
        try
        {
            specialties = await Http.GetFromJsonAsync<List<SpecialtyDto>>("api/admin/specialties") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải chuyên khoa: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadDoctor()
    {
        isLoading = true;
        try
        {
            doctor = await Http.GetFromJsonAsync<DoctorProfileDto>($"api/admin/doctors/{DoctorId}");
            if (doctor != null)
            {
                updateDto = new UpdateDoctorProfileDto
                {
                    FullName = doctor.FullName,
                    Phone = doctor.Phone,
                    SpecialtyId = doctor.SpecialtyId,
                    Qualifications = doctor.Qualifications,
                    Experience = doctor.Experience,
                    ConsultationFee = doctor.ConsultationFee,
                    Bio = doctor.Bio
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải thông tin bác sĩ: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/admin/doctors/{DoctorId}", updateDto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Cập nhật thông tin bác sĩ thành công", Severity.Success);
                Navigation.NavigateTo("/admin/doctors");
            }
            else
            {
                Snackbar.Add("Không thể cập nhật thông tin bác sĩ", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/doctors");
    }
}
