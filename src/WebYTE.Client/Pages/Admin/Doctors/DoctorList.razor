@page "/admin/doctors"
@using WebYTE.Application.DTOs.Doctor
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Quản Lý Bác Sĩ</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Large" Class="mr-2" />
        Quản Lý Bác Sĩ
    </MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4">
            <MudTable Items="@doctors" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Danh Sách Bác Sĩ</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString" Placeholder="Tìm kiếm..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Họ Tên</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Số Điện Thoại</MudTh>
                    <MudTh>Chuyên Khoa</MudTh>
                    <MudTh>Kinh Nghiệm</MudTh>
                    <MudTh>Phí Khám</MudTh>
                    <MudTh>Thao Tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Họ Tên">@context.FullName</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Số Điện Thoại">@context.Phone</MudTd>
                    <MudTd DataLabel="Chuyên Khoa">@context.SpecialtyName</MudTd>
                    <MudTd DataLabel="Kinh Nghiệm">@context.Experience</MudTd>
                    <MudTd DataLabel="Phí Khám">@context.ConsultationFee.ToString("N0") VNĐ</MudTd>
                    <MudTd DataLabel="Thao Tác">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => EditDoctor(context.DoctorId))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteDoctor(context.DoctorId))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<DoctorProfileDto> doctors = new();
    private List<DoctorProfileDto> filteredDoctors = new();
    private bool isLoading = true;
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        isLoading = true;
        try
        {
            doctors = await Http.GetFromJsonAsync<List<DoctorProfileDto>>("api/admin/doctors") ?? new();
            filteredDoctors = doctors;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải danh sách bác sĩ: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditDoctor(Guid doctorId)
    {
        Navigation.NavigateTo($"/admin/doctors/{doctorId}");
    }

    private async Task DeleteDoctor(Guid doctorId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/admin/doctors/{doctorId}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Xóa bác sĩ thành công", Severity.Success);
                await LoadDoctors();
            }
            else
            {
                Snackbar.Add("Không thể xóa bác sĩ", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }
}
