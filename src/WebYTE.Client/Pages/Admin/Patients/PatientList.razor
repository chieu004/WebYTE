@page "/admin/patients"
@using WebYTE.Application.DTOs.Patient
@using WebYTE.Core.Enums
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Quản Lý Bệnh Nhân</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Class="mr-2" />
        Quản Lý Bệnh Nhân
    </MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4">
            <MudTable Items="@patients" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Danh Sách Bệnh Nhân</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString" Placeholder="Tìm kiếm..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Họ Tên</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Số Điện Thoại</MudTh>
                    <MudTh>Ngày Sinh</MudTh>
                    <MudTh>Giới Tính</MudTh>
                    <MudTh>Nhóm Máu</MudTh>
                    <MudTh>Thao Tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Họ Tên">@context.FullName</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Số Điện Thoại">@context.Phone</MudTd>
                    <MudTd DataLabel="Ngày Sinh">@context.DateOfBirth.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Giới Tính">@GetGenderText(context.Gender)</MudTd>
                    <MudTd DataLabel="Nhóm Máu">@context.BloodType</MudTd>
                    <MudTd DataLabel="Thao Tác">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => EditPatient(context.PatientId))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeletePatient(context.PatientId))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<PatientProfileDto> patients = new();
    private bool isLoading = true;
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        isLoading = true;
        try
        {
            patients = await Http.GetFromJsonAsync<List<PatientProfileDto>>("api/admin/patients") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải danh sách bệnh nhân: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditPatient(Guid patientId)
    {
        Navigation.NavigateTo($"/admin/patients/{patientId}");
    }

    private async Task DeletePatient(Guid patientId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/admin/patients/{patientId}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Xóa bệnh nhân thành công", Severity.Success);
                await LoadPatients();
            }
            else
            {
                Snackbar.Add("Không thể xóa bệnh nhân", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }

    private string GetGenderText(Gender gender)
    {
        return gender switch
        {
            Gender.Male => "Nam",
            Gender.Female => "Nữ",
            Gender.Other => "Khác",
            _ => "Không xác định"
        };
    }
}
