@page "/ai-triage"
@using WebYTE.Application.DTOs.AI
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Trợ Lý Chuẩn Đoán AI - WebYTE</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Tertiary" Class="mb-4 d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Large" Class="mr-3" />
        Hỏi Bác Sĩ Cảnh Báo Sớm
    </MudText>
    
    <MudText Typo="Typo.body1" Class="mb-6 text-muted">Mô tả triệu chứng của bạn bằng tiếng Việt. Trợ lý AI sẽ tư vấn sơ bộ và gợi ý Chuyên khoa nên đăng ký khám.</MudText>

    <MudCard Elevation="4" Class="pa-4 mb-8" Style="background-color:#F5F7FA;">
        <MudCardContent>
            @if (response != null)
            {
                <MudPaper Class="pa-4 mb-6" Elevation="1" Style="background-color:#E2F0CB;">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="font-weight-bold mb-2">Bác sĩ AI trả lời:</MudText>
                    <MudText Style="white-space: pre-line;">@response.TriageResult</MudText>
                    
                    <MudDivider Class="my-4"/>
                    
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText><strong>Gợi ý Chuyên Khoa:</strong> <MudChip T="string" Color="Color.Secondary" Size="Size.Small">@response.SuggestedSpecialty</MudChip></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            @if(response.RequiresImmediateAttention)
                            {
                                <MudAlert Severity="Severity.Error">CẢNH BÁO: Cần can thiệp y tế NGAY LẬP TỨC!</MudAlert>
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <MudTextField @bind-Value="symptomsText" Label="Ví dụ: Tôi bị đau tức ngực trái lan ra tay..."
                          Variant="Variant.Outlined" Lines="4" Class="mb-4" />

            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Large" 
                       EndIcon="@Icons.Material.Filled.Send" OnClick="Analyze" Disabled="isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true"/>
                    <MudText>AI Đang Suy Nghĩ...</MudText>
                }
                else
                {
                    <MudText>Gửi Phân Tích</MudText>
                }
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string symptomsText = string.Empty;
    private bool isLoading = false;
    private AiTriageResponseDto? response;

    private async Task Analyze()
    {
        if (string.IsNullOrWhiteSpace(symptomsText))
        {
            Snackbar.Add("Vui lòng nhập triệu chứng của bạn.", Severity.Warning);
            return;
        }

        isLoading = true;
        response = null;

        try
        {
            var req = new AiTriageRequestDto { Symptoms = symptomsText };
            var res = await Http.PostAsJsonAsync("api/aitriage/analyze", req);
            
            if (res.IsSuccessStatusCode)
            {
                response = await res.Content.ReadFromJsonAsync<AiTriageResponseDto>();
            }
            else
            {
                Snackbar.Add("Lỗi từ máy chủ AI. Vui lòng thử lại sau.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể kết nối Backend. Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
