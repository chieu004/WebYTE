@page "/invoice/{InvoiceId:guid}"
@using WebYTE.Application.DTOs.Invoice
@using WebYTE.Core.Enums
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using System.Web
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Hóa Đơn - @invoiceNumber</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">
    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (invoice == null)
    {
        <MudAlert Severity="Severity.Error">Không tìm thấy hóa đơn</MudAlert>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-8">
            <!-- Header -->
            <div class="d-flex justify-space-between align-center mb-6">
                <div>
                    <MudText Typo="Typo.h3" Color="Color.Primary">HÓA ĐƠN THANH TOÁN</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Secondary">WebYTE Medical Center</MudText>
                </div>
                <div class="text-right">
                    <MudText Typo="Typo.body1"><strong>Mã HĐ:</strong> @invoice.InvoiceNumber</MudText>
                    <MudText Typo="Typo.body2">Ngày: @invoice.IssuedDate.ToString("dd/MM/yyyy")</MudText>
                    @if (invoice.DueDate.HasValue)
                    {
                        <MudText Typo="Typo.body2">Hạn TT: @invoice.DueDate.Value.ToString("dd/MM/yyyy")</MudText>
                    }
                </div>
            </div>

            <MudDivider Class="mb-4" />

            <!-- Thông tin bệnh nhân và bác sĩ -->
            <MudGrid Class="mb-6">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">Thông Tin Bệnh Nhân</MudText>
                    <MudText Typo="Typo.body1"><strong>Họ tên:</strong> @invoice.PatientName</MudText>
                    <MudText Typo="Typo.body1"><strong>SĐT:</strong> @invoice.PatientPhone</MudText>
                    <MudText Typo="Typo.body1"><strong>Địa chỉ:</strong> @invoice.PatientAddress</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">Thông Tin Bác Sĩ</MudText>
                    <MudText Typo="Typo.body1"><strong>Bác sĩ:</strong> @invoice.DoctorName</MudText>
                    <MudText Typo="Typo.body1"><strong>Chuyên khoa:</strong> @invoice.SpecialtyName</MudText>
                    <MudText Typo="Typo.body1"><strong>Ngày khám:</strong> @invoice.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="mb-4" />

            <!-- Thông tin khám bệnh -->
            <div class="mb-6">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">Thông Tin Khám Bệnh</MudText>
                <MudText Typo="Typo.body1"><strong>Lý do khám:</strong> @invoice.Reason</MudText>
                @if (!string.IsNullOrEmpty(invoice.Diagnosis))
                {
                    <MudText Typo="Typo.body1"><strong>Chẩn đoán:</strong> @invoice.Diagnosis</MudText>
                }
            </div>

            <MudDivider Class="mb-4" />

            <!-- Chi tiết chi phí -->
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">Chi Tiết Chi Phí</MudText>

            <MudSimpleTable Class="mb-4" Dense="true" Bordered="true">
                <thead>
                    <tr>
                        <th>Dịch vụ</th>
                        <th class="text-right">Số lượng</th>
                        <th class="text-right">Đơn giá</th>
                        <th class="text-right">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Phí khám -->
                    <tr>
                        <td><strong>Phí khám bệnh</strong></td>
                        <td class="text-right">1</td>
                        <td class="text-right">@invoice.ConsultationFee.ToString("N0") VNĐ</td>
                        <td class="text-right">@invoice.ConsultationFee.ToString("N0") VNĐ</td>
                    </tr>

                    <!-- Thuốc -->
                    @if (invoice.Medications.Any())
                    {
                        <tr>
                            <td colspan="4" class="bg-light"><strong>Đơn Thuốc</strong></td>
                        </tr>
                        @foreach (var med in invoice.Medications)
                        {
                            <tr>
                                <td>
                                    @med.MedicationName
                                    <br />
                                    <small class="text-muted">
                                        Liều dùng: @med.Dosage
                                        @if (!string.IsNullOrEmpty(med.Instructions))
                                        {
                                            <br />@med.Instructions
                                        }
                                    </small>
                                </td>
                                <td class="text-right">@med.Quantity</td>
                                <td class="text-right">@med.UnitPrice.ToString("N0") VNĐ</td>
                                <td class="text-right">@med.TotalPrice.ToString("N0") VNĐ</td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>

            <!-- Tổng cộng -->
            <div class="text-right mb-4">
                <MudText Typo="Typo.body1">
                    <strong>Tạm tính:</strong> @((invoice.ConsultationFee + invoice.MedicationTotal).ToString("N0")) VNĐ
                </MudText>
                <MudText Typo="Typo.body1">
                    <strong>Thuế VAT (8%):</strong> @invoice.TaxAmount.ToString("N0") VNĐ
                </MudText>
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.h5" Color="Color.Primary">
                    <strong>TỔNG CỘNG:</strong> @invoice.TotalAmount.ToString("N0") VNĐ
                </MudText>
            </div>

            <MudDivider Class="my-4" />

            <!-- QR Code Thanh Toán -->
            <div class="text-center mb-6 no-print">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode2" Class="mr-2" />
                    Quét Mã QR Để Thanh Toán
                </MudText>
                <MudPaper Elevation="2" Class="pa-4 d-inline-block">
                    <img src="@GetVietQRUrl()" alt="QR Code Thanh Toán" style="width: 250px; height: 250px;" />
                    <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
                        Quét mã QR bằng app ngân hàng để thanh toán nhanh
                    </MudText>
                    @if (invoice.BankingInfo != null)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">
                            <strong>Ngân hàng:</strong> @invoice.BankingInfo.BankName<br />
                            <strong>Số TK:</strong> @invoice.BankingInfo.AccountNo<br />
                            <strong>Chủ TK:</strong> @invoice.BankingInfo.AccountName<br />
                            <strong>Số tiền:</strong> @invoice.TotalAmount.ToString("N0") VNĐ<br />
                            <strong>Nội dung:</strong> @GetPaymentContent()
                        </MudText>
                    }
                </MudPaper>
            </div>

            @if (!string.IsNullOrEmpty(invoice.Notes))
            {
                <MudDivider Class="mb-4" />
                <MudText Typo="Typo.body2" Class="mb-2"><strong>Ghi chú:</strong></MudText>
                <MudText Typo="Typo.body2">@invoice.Notes</MudText>
            }

            <MudDivider Class="my-4" />

            <!-- Footer -->
            <div class="text-center">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Cảm ơn quý khách đã tin tưởng sử dụng dịch vụ của chúng tôi
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    WebYTE Medical Center - Hotline: 1900-1080 - Email: support@webyte.vn
                </MudText>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-center gap-4 mt-6">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PrintInvoice">
                    <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" />
                    In Hóa Đơn
                </MudButton>
                
                @if (canConfirmPayment)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmPayment">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
                        Xác Nhận Đã Thanh Toán
                    </MudButton>
                }
                
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="GoBack">
                    Đóng
                </MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>

<style>
    @@media print {
        .mud-button, .no-print {
            display: none !important;
        }
        
        .mud-paper {
            box-shadow: none !important;
        }
    }
    
    .bg-light {
        background-color: #f5f5f5;
    }
</style>

@code {
    [Parameter]
    public Guid InvoiceId { get; set; }

    private InvoiceDto? invoice;
    private bool isLoading = true;
    private string invoiceNumber = "";
    private bool canConfirmPayment = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoice();
    }

    private async Task LoadInvoice()
    {
        isLoading = true;
        try
        {
            invoice = await Http.GetFromJsonAsync<InvoiceDto>($"api/invoice/{InvoiceId}");
            if (invoice != null)
            {
                invoiceNumber = invoice.InvoiceNumber;
                
                // Chỉ Staff/Admin mới có quyền xác nhận thanh toán
                // Và chỉ khi invoice ở trạng thái Created/Sent
                canConfirmPayment = (invoice.Status == InvoiceStatus.Created || invoice.Status == InvoiceStatus.Sent);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading invoice: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmPayment()
    {
        if (invoice == null) return;

        try
        {
            // Cập nhật trạng thái thanh toán của appointment
            var response = await Http.PutAsJsonAsync($"api/staff/appointments/{invoice.AppointmentId}/payment", new { PaymentStatus = 3 });
            
            if (response.IsSuccessStatusCode)
            {
                // Cập nhật trạng thái invoice
                var invoiceResponse = await Http.PutAsJsonAsync($"api/invoice/{InvoiceId}/status", new { Status = 3 });
                
                if (invoiceResponse.IsSuccessStatusCode)
                {
                    canConfirmPayment = false;
                    await LoadInvoice(); // Reload để cập nhật UI
                    
                    // Show success message using JavaScript alert
                    await JSRuntime.InvokeVoidAsync("alert", "Đã xác nhận thanh toán thành công!");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: {error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: {ex.Message}");
        }
    }

    private void PrintInvoice()
    {
        // Trigger browser print dialog
        JSRuntime.InvokeVoidAsync("window.print");
    }

    private void GoBack()
    {
        // Close window if opened in new tab, otherwise navigate back
        JSRuntime.InvokeVoidAsync("window.close");
    }

    // Tạo nội dung thanh toán
    private string GetPaymentContent()
    {
        if (invoice == null) return "";
        // Format: HĐ [Mã HĐ] - [Tên BN]
        return $"HD {invoice.InvoiceNumber} {invoice.PatientName}";
    }

    // Tạo URL VietQR - Chuẩn ngân hàng VN
    private string GetVietQRUrl()
    {
        if (invoice == null || invoice.BankingInfo == null) return "";

        // Lấy thông tin từ DTO
        string bankId = invoice.BankingInfo.BankId;
        string accountNo = invoice.BankingInfo.AccountNo;
        string accountName = invoice.BankingInfo.AccountName;
        string amount = ((int)invoice.TotalAmount).ToString();
        string addInfo = GetPaymentContent();
        
        // Sử dụng API VietQR miễn phí từ api.vietqr.io
        // Template: compact2 (gọn gàng, có logo ngân hàng)
        var qrUrl = $"https://img.vietqr.io/image/{bankId}-{accountNo}-compact2.png?" +
                    $"amount={amount}&" +
                    $"addInfo={Uri.EscapeDataString(addInfo)}&" +
                    $"accountName={Uri.EscapeDataString(accountName)}";
        
        return qrUrl;
    }
}
