@page "/staff/appointments"
@using WebYTE.Application.DTOs.Appointment
@using WebYTE.Core.Enums
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Quản Lý Lịch Hẹn</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Class="mr-2" />
        Quản Lý Lịch Hẹn
    </MudText>

    <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
        <MudTabPanel Text="Chờ Xử Lý" Icon="@Icons.Material.Filled.HourglassEmpty">
            @if (isLoading)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            }
            else if (pendingAppointments.Any())
            {
                <MudTable Items="@pendingAppointments" Hover="true" Breakpoint="Breakpoint.Sm" @key="@($"pending-{pendingAppointments.Count}-{DateTime.Now.Ticks}")">
                    <HeaderContent>
                        <MudTh>Ngày Giờ</MudTh>
                        <MudTh>Bệnh Nhân</MudTh>
                        <MudTh>Bác Sĩ</MudTh>
                        <MudTh>Lý Do</MudTh>
                        <MudTh>Thanh Toán</MudTh>
                        <MudTh>Thao Tác</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ngày Giờ">
                            @context.AppointmentDate.ToString("dd/MM/yyyy HH:mm")
                        </MudTd>
                        <MudTd DataLabel="Bệnh Nhân">@context.PatientName</MudTd>
                        <MudTd DataLabel="Bác Sĩ">@context.DoctorName</MudTd>
                        <MudTd DataLabel="Lý Do">@context.Reason</MudTd>
                        <MudTd DataLabel="Thanh Toán">
                            <MudChip T="string" Color="@GetPaymentColor(context.PaymentStatus)" Size="Size.Small">
                                @GetPaymentText(context.PaymentStatus)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Thao Tác">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="@(() => ConfirmAppointment(context.Id))">
                                Xác Nhận
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                       OnClick="@(() => CancelAppointment(context.Id))" Class="ml-2">
                                Hủy
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info">Không có lịch hẹn chờ xử lý.</MudAlert>
            }
        </MudTabPanel>

        <MudTabPanel Text="Tất Cả" Icon="@Icons.Material.Filled.List">
            @if (isLoading)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            }
            else if (allAppointments.Any())
            {
                <MudTable Items="@allAppointments" Hover="true" Breakpoint="Breakpoint.Sm" @key="@($"all-{allAppointments.Count}-{DateTime.Now.Ticks}")">
                    <HeaderContent>
                        <MudTh>Ngày Giờ</MudTh>
                        <MudTh>Bệnh Nhân</MudTh>
                        <MudTh>Bác Sĩ</MudTh>
                        <MudTh>Lý Do</MudTh>
                        <MudTh>Trạng Thái</MudTh>
                        <MudTh>Thanh Toán</MudTh>
                        <MudTh>Thao Tác</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ngày Giờ">
                            @context.AppointmentDate.ToString("dd/MM/yyyy HH:mm")
                        </MudTd>
                        <MudTd DataLabel="Bệnh Nhân">@context.PatientName</MudTd>
                        <MudTd DataLabel="Bác Sĩ">@context.DoctorName</MudTd>
                        <MudTd DataLabel="Lý Do">@context.Reason</MudTd>
                        <MudTd DataLabel="Trạng Thái">
                            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                                @GetStatusText(context.Status)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Thanh Toán">
                            <MudChip T="string" Color="@GetPaymentColor(context.PaymentStatus)" Size="Size.Small">
                                @GetPaymentText(context.PaymentStatus)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Thao Tác">
                            @if ((int)context.PaymentStatus == 1)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="@(() => ProcessPayment(context.Id))">
                                    Xử Lý TT
                                </MudButton>
                            }
                            else if ((int)context.PaymentStatus == 2)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info"
                                           OnClick="@(() => GenerateInvoice(context.Id))">
                                    Xuất Hóa Đơn
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
                    </PagerContent>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info">Chưa có lịch hẹn nào.</MudAlert>
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private List<AppointmentDto> pendingAppointments = new();
    private List<AppointmentDto> allAppointments = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        isLoading = true;
        try
        {
            // Load pending appointments cho tab "Chờ Xử Lý"
            pendingAppointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/staff/appointments/pending") ?? new();
            
            // Load tất cả appointments cho tab "Tất Cả"
            allAppointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/staff/appointments") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải lịch hẹn: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmAppointment(Guid appointmentId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            // Status: 2 = Confirmed (không phải 1!)
            var response = await Http.PutAsJsonAsync($"api/staff/appointments/{appointmentId}/status", new { Status = 2 });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Xác nhận lịch hẹn thành công", Severity.Success);
                
                // Force reload data
                pendingAppointments = new List<AppointmentDto>();
                allAppointments = new List<AppointmentDto>();
                StateHasChanged();
                
                await Task.Delay(100); // Small delay to ensure UI updates
                await LoadAppointments();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Lỗi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CancelAppointment(Guid appointmentId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            // Status: 4 = Cancelled (không phải 3!)
            var response = await Http.PutAsJsonAsync($"api/staff/appointments/{appointmentId}/status", new { Status = 4 });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Hủy lịch hẹn thành công", Severity.Success);
                
                // Force reload data
                pendingAppointments = new List<AppointmentDto>();
                allAppointments = new List<AppointmentDto>();
                StateHasChanged();
                
                await Task.Delay(100);
                await LoadAppointments();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Lỗi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ProcessPayment(Guid appointmentId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            // PaymentStatus.Pending = 2 - Chờ thanh toán
            var response = await Http.PutAsJsonAsync($"api/staff/appointments/{appointmentId}/payment", new { PaymentStatus = 2 });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Chuyển sang trạng thái Chờ thanh toán", Severity.Success);
                
                // Force reload data
                pendingAppointments = new List<AppointmentDto>();
                allAppointments = new List<AppointmentDto>();
                StateHasChanged();
                
                await Task.Delay(100);
                await LoadAppointments();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Lỗi: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GenerateInvoice(Guid appointmentId)
    {
        try
        {
            var response = await Http.PostAsync($"api/invoice/generate/{appointmentId}", null);
            if (response.IsSuccessStatusCode)
            {
                var invoiceId = await response.Content.ReadFromJsonAsync<Guid>();
                
                // Cập nhật trạng thái thanh toán sang "Đã thanh toán"
                var updateResponse = await Http.PutAsJsonAsync($"api/staff/appointments/{appointmentId}/payment", new { PaymentStatus = 3 });
                
                if (updateResponse.IsSuccessStatusCode)
                {
                    Snackbar.Add("Đã xuất hóa đơn và cập nhật trạng thái thanh toán", Severity.Success);
                    
                    // Reload data
                    await LoadAppointments();
                }
                
                // Mở hóa đơn trong tab mới - Sử dụng InvokeVoidAsync để tránh lỗi circular reference
                var url = $"/invoice/{invoiceId}";
                await JSRuntime.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Lỗi tạo hóa đơn: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending => Color.Warning,
            AppointmentStatus.Confirmed => Color.Info,
            AppointmentStatus.Completed => Color.Success,
            AppointmentStatus.Cancelled => Color.Error,
            AppointmentStatus.NoShow => Color.Dark,
            _ => Color.Default
        };
    }

    private string GetStatusText(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending => "Chờ xác nhận",
            AppointmentStatus.Confirmed => "Đã xác nhận",
            AppointmentStatus.Completed => "Hoàn thành",
            AppointmentStatus.Cancelled => "Đã hủy",
            AppointmentStatus.NoShow => "Không đến",
            _ => "Không xác định"
        };
    }

    private Color GetPaymentColor(PaymentStatus paymentStatus)
    {
        return paymentStatus switch
        {
            PaymentStatus.Unpaid => Color.Error,
            PaymentStatus.Pending => Color.Warning,
            PaymentStatus.Paid => Color.Success,
            PaymentStatus.Failed => Color.Error,
            PaymentStatus.Refunded => Color.Dark,
            _ => Color.Default
        };
    }

    private string GetPaymentText(PaymentStatus paymentStatus)
    {
        return paymentStatus switch
        {
            PaymentStatus.Unpaid => "Chưa thanh toán",
            PaymentStatus.Pending => "Chờ thanh toán",
            PaymentStatus.Paid => "Đã thanh toán",
            PaymentStatus.Failed => "Thất bại",
            PaymentStatus.Refunded => "Đã hoàn tiền",
            _ => "Không xác định"
        };
    }
}
